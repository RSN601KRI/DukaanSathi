# Server-only. Set these as project secrets (Lovable) or Vercel environment
# variables — never commit real values.
# Leave credentials blank to run the public, browser-only demo locally.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Endpoint URLs come from the official Gnani AI docs (docs.gnani.ai) and must
# be pasted clean — no trailing spaces or "Copy" text from the docs page:
#   STT: https://api.vachana.ai/stt/v3
#   TTS: https://api.vachana.ai/api/v1/tts/inference
# Auth follows Gnani's documented header: X-API-Key-ID (no prefix).
GNANI_API_KEY=
# Optional endpoint overrides — defaults match the Gnani docs.
# GNANI_STT_URL=https://api.vachana.ai/stt/v3
# GNANI_TTS_URL=https://api.vachana.ai/api/v1/tts/inference
GNANI_AUTH_HEADER=X-API-Key-ID
GNANI_AUTH_PREFIX=
# Leave empty to select Nalini (Hindi), Poorvi (Hinglish), or Kaveri (English)
# automatically. See docs.gnani.ai/api/TTS/available-voices for the catalog.
GNANI_TTS_VOICE=
